# ==============================================================================
# MESTERI PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# This is a template for environment variables required by the Mesteri Platform.
# Copy this file to .env and fill in the actual values.
#
# SECURITY WARNING: Never commit the actual .env file to version control!
# ==============================================================================

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://mesteri_user:secure_password_here@localhost:5432/mesteri_db"

# ==============================================================================
# FIREBASE CONFIGURATION
# ==============================================================================
# Get these from: Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# ==============================================================================
# STRIPE PAYMENT CONFIGURATION
# ==============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development
# Use live keys (sk_live_...) for production
STRIPE_SECRET_KEY="sk_test_51YOUR_STRIPE_SECRET_KEY_HERE"
STRIPE_PUBLISHABLE_KEY="pk_test_51YOUR_STRIPE_PUBLISHABLE_KEY_HERE"

# Get this from: https://dashboard.stripe.com/webhooks
# Create webhook endpoint: https://yourdomain.com/api/payments/stripe/webhook
# Events to listen for: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# ==============================================================================
# SIGNREQUEST CONFIGURATION (Digital Contract Signing)
# ==============================================================================
# Get from: https://signrequest.com/api/v1/docs/
# For development: Use sandbox environment
SIGNREQUEST_API_URL="https://api.signrequest.com/v1"
SIGNREQUEST_API_TOKEN="YOUR_SIGNREQUEST_API_TOKEN_HERE"

# ==============================================================================
# GOOGLE CLOUD STORAGE (Contract & Media Storage)
# ==============================================================================
# Bucket name for storing contracts
GCS_CONTRACTS_BUCKET="mesteri-contracts-prod"

# Path to Google Cloud Service Account JSON key file
# Download from: Google Cloud Console > IAM & Admin > Service Accounts
GCS_KEY_FILE="/path/to/your-gcs-service-account-key.json"

# Or set as JSON string:
# GOOGLE_APPLICATION_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ==============================================================================
# SMTP CONFIGURATION (Email Notifications)
# ==============================================================================
# Gmail configuration (recommended for development)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false  # Use TLS

# For Gmail: Create an App Password
# Instructions: https://support.google.com/accounts/answer/185833
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-here"

# Email sender details
FROM_EMAIL="no-reply@mesteri.ro"
FROM_NAME="Mesteri Platform"

# ==============================================================================
# APPLICATION URLs
# ==============================================================================
# Frontend URL (where Flutter web app is hosted)
FRONTEND_URL="https://app.mesteri.ro"

# API Base URL (where backend is hosted)
API_BASE_URL="https://api.mesteri.ro"

# ==============================================================================
# JWT & SESSION SECRETS
# ==============================================================================
# Generate strong random strings (32+ characters)
# Use: openssl rand -base64 32
JWT_SECRET="GENERATE_A_SECURE_RANDOM_STRING_HERE_32_CHARS_MINIMUM"
SESSION_SECRET="GENERATE_ANOTHER_SECURE_RANDOM_STRING_HERE_32_CHARS"

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV=production

# ==============================================================================
# FILE UPLOAD CONFIGURATION
# ==============================================================================
UPLOAD_PATH="./storage/uploads"

# Max file sizes in bytes
MAX_IMAGE_SIZE=10485760      # 10 MB
MAX_VIDEO_SIZE=104857600     # 100 MB
MAX_BATCH_FILES=10

# Image processing
IMAGE_QUALITY=85             # JPEG quality (0-100)
THUMBNAIL_SIZE=300           # pixels
MEDIUM_SIZE=800              # pixels

# Video processing
VIDEO_MAX_RESOLUTION=720     # 720p
MAX_VIDEO_DURATION=300       # 5 minutes in seconds

# Security
ENABLE_MALWARE_SCAN=false    # Set to true if ClamAV is installed

# ==============================================================================
# NOTIFICATION CONFIGURATION
# ==============================================================================
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RATE_LIMIT_PER_USER=100

# ==============================================================================
# OPTIONAL: Advanced Configuration
# ==============================================================================

# Logging
LOG_LEVEL=info               # error, warn, info, debug, verbose

# CORS (if needed)
# CORS_ORIGIN="https://app.mesteri.ro,https://www.mesteri.ro"

# Rate Limiting
# RATE_LIMIT_WINDOW=900000    # 15 minutes in milliseconds
# RATE_LIMIT_MAX_REQUESTS=100 # Max requests per window

# ==============================================================================
# DEVELOPMENT-ONLY (Remove in production)
# ==============================================================================
# Uncomment these for local development:
# DATABASE_URL="postgresql://mesteri_user:mesteri_pass@localhost:5432/mesteri_db"
# FRONTEND_URL="http://localhost:8080"
# API_BASE_URL="http://localhost:3000"
# NODE_ENV=development
