# Database Configuration
DATABASE_URL="postgresql://mesteri_user:mesteri_pass@localhost:5432/mesteri_db"

# Firebase Configuration
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_KEY="your-service-account-key-json"

# SignRequest Configuration (Sandbox for development)
SIGNREQUEST_API_URL="https://api.signrequest.com/v1"
SIGNREQUEST_API_TOKEN="sr_sandbox_your_token_here"

# Google Cloud Storage for Contracts
GCS_CONTRACTS_BUCKET="mesteri-contracts-dev"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_your_stripe_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# SMTP Configuration for Email Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="no-reply@mesteri.ro"
FROM_NAME="Mesteri Platform"

# Application Configuration
FRONTEND_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3000"

# JWT Secret
JWT_SECRET="your-jwt-secret-key-here"
SESSION_SECRET="your-session-secret-here"

# Port
PORT=3000

# Upload Configuration
UPLOAD_PATH="./storage/uploads"
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
MAX_BATCH_FILES=10
IMAGE_QUALITY=85
THUMBNAIL_SIZE=300
MEDIUM_SIZE=800
VIDEO_MAX_RESOLUTION=720
MAX_VIDEO_DURATION=300
ENABLE_MALWARE_SCAN=false

# Notification Configuration
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RATE_LIMIT_PER_USER=100

# Node Environment
NODE_ENV=development