# Production Environment Variables
# IMPORTANT: Never commit actual secrets to git!

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=mesteri_user
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_DATABASE=mesteri_db
DATABASE_URL=postgresql://mesteri_user:CHANGE_ME_IN_PRODUCTION@postgres:5432/mesteri_db?schema=public

# Firebase Configuration
FIREBASE_PROJECT_ID=trueworkers-prod
FIREBASE_SERVICE_ACCOUNT_KEY=CHANGE_ME_TO_PRODUCTION_KEY

# App Configuration
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://yourdomain.com
API_BASE_URL=https://api.yourdomain.com

# WebSocket Configuration
WS_CORS_ORIGIN=https://yourdomain.com

# Prisma Configuration
PRISMA_GENERATE_DATAPROXY=false
PRISMA_GENERATE_ENGINE_TYPE=library

# Security (generate strong random values)
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
SESSION_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# External Services (add your keys)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Storage (if using Google Cloud Storage)
GCS_BUCKET_NAME=your_bucket_name
GCS_PROJECT_ID=your_gcs_project

# Email (if using SendGrid or similar)
EMAIL_FROM=noreply@yourdomain.com
EMAIL_API_KEY=your_email_api_key

# Payment Gateway (add when ready)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
